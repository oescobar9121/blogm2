{
    "name": "oescobar/module-blog",
    "description": "OEscobar Blog module (posts & comments) for Adobe Commerce/Magento 2",
    "type": "magento2-module",
    "license": "proprietary",
    "require": {
        "php": "^8.1",
        "magento/framework": "*",
        "magento/module-backend": "*",
        "magento/module-ui": "*",
        "magento/module-authorization": "*",
        "magento/module-webapi": "*",
        "magento/module-cms": "*",
        "magento/module-graph-ql": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "magento/magento-coding-standard": "^25"
    },
    "autoload": {
        "files": [
            "registration.php"
        ],
        "psr-4": {
            "OEscobar\\Blog\\": ""
        }
    },
    "autoload-dev": {
        "psr-4": {
            "OEscobar\\Blog\\Test\\": "Test/"
        }
    },
    "scripts": {
        "test": "phpunit -c phpunit.xml.dist",
        "cs": "phpcs -s",
        "cs:fix": "phpcbf"
    }
}
