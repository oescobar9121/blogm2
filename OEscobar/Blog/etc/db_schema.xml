<?xml version="1.0"?>
<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">

    <table name="oescobar_blog_post" resource="default" engine="innodb" comment="Blog Posts">
        <column xsi:type="int" name="post_id" nullable="false" identity="true" unsigned="true" comment="Post ID"/>
        <column xsi:type="varchar" name="title" nullable="false" length="255" comment="Title"/>
        <column xsi:type="text" name="content" nullable="false" comment="Content"/>
        <column xsi:type="varchar" name="author" nullable="true" length="128" comment="Author"/>
        <column xsi:type="smallint" name="status" nullable="false" default="1" comment="Status (1=enabled,0=disabled)"/>
        <column xsi:type="timestamp" name="created_at" on_update="false" default="CURRENT_TIMESTAMP" nullable="false"
                comment="Created At"/>
        <column xsi:type="timestamp" name="updated_at" on_update="true" default="CURRENT_TIMESTAMP" nullable="false"
                comment="Updated At"/>

        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="post_id"/>
        </constraint>
        <index referenceId="OESC_BLOG_POST_STATUS" indexType="btree">
            <column name="status"/>
        </index>
    </table>

    <table name="oescobar_blog_comment" resource="default" engine="innodb" comment="Blog Comments">
        <column xsi:type="int" name="comment_id" nullable="false" identity="true" unsigned="true" comment="Comment ID"/>
        <column xsi:type="int" name="post_id" nullable="false" unsigned="true" comment="Related Post ID"/>
        <column xsi:type="text" name="content" nullable="false" comment="Content"/>
        <column xsi:type="varchar" name="author" nullable="true" length="128" comment="Author"/>
        <column xsi:type="smallint" name="status" nullable="false" default="1" comment="Status (1=approved,0=pending)"/>
        <column xsi:type="timestamp" name="created_at" on_update="false" default="CURRENT_TIMESTAMP" nullable="false"
                comment="Created At"/>

        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="comment_id"/>
        </constraint>
        <constraint xsi:type="foreign" referenceId="OESC_BLOG_COMMENT_POST_FK"
                    table="oescobar_blog_comment" column="post_id"
                    referenceTable="oescobar_blog_post" referenceColumn="post_id"
                    onDelete="CASCADE"/>
        <index referenceId="OESC_BLOG_COMMENT_POST" indexType="btree">
            <column name="post_id"/>
        </index>
    </table>

</schema>
